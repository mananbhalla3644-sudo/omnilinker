# OmniLinker configuration. Copy to `.env` and edit, or export these directly.
#
# Every value has a working default: `cp .env.example .env` and the system runs
# with the embedded store, encryption on, and the synthetic demo workspace.
# Nothing here is required to start the app, which is the point - the settings
# that matter most are the ones you should have to choose deliberately, and
# those are the ones with no default that changes behaviour silently.

# --- profile ---------------------------------------------------------------
# embedded = JSON document store + in-memory graph. No external services.
# docker   = MongoDB + Neo4j. The blueprint's real deployment.
# cloud    = managed equivalents of the above.
OMNI_MODE=embedded

# Where the keystore, the store and the index live. Treat this directory as
# the crown jewel: the keystore inside it is the only thing standing between a
# database dump and every sealed message body.
OMNI_DATA_DIR=./omni-data

# Tenant scope. Every document, identity and edge is namespaced by this, and
# the workspace id is part of the AAD binding - so changing it makes existing
# ciphertexts undecryptable. It is not a tenancy feature you can toggle later.
OMNI_WORKSPACE=ws_local

# --- crypto ----------------------------------------------------------------
# AES-256-GCM envelope encryption on content fields. Turning this off stores
# message bodies in the clear, so there is no default-on reason to do it.
OMNI_ENCRYPT=1

# --- search ----------------------------------------------------------------
# The second retrieval leg. Hashed bag-of-words, so it needs no model and no
# network. See docs/adr/ADR-023.md for what it does and does not capture.
OMNI_VECTOR=1
OMNI_EMBED_MODEL=hash-1024

# Persist the inverted index to disk. Off by default: an index has to contain
# the corpus vocabulary in order to rank, so writing it out creates a second
# plaintext store. When enabled, OMNI_INDEX_K drops terms rarer than k
# documents, because a term in one document is effectively a verbatim quote.
OMNI_PERSIST_INDEX=0
OMNI_INDEX_K=2

# --- identity resolution ---------------------------------------------------
# Merge threshold. At or above this, two accounts are one Person.
# Lower it to merge more aggressively; the precision target in the blueprint is
# 0.95, so lowering it trades that for recall.
OMNI_MERGE_T=0.90
# At or above this, but below the merge threshold, a pair becomes a suggestion
# for a human to accept. Only a user action can promote a suggestion.
OMNI_SUGGEST_T=0.65

# --- ai --------------------------------------------------------------------
# extractive = TextRank; every summary sentence is a verbatim span of a
#              document, so every claim is clickable to its source.
# lead       = first-k baseline, kept for comparison.
# local / cloud = route to a model gateway behind the same interface.
AI_MODE=extractive

# --- web -------------------------------------------------------------------
# Empty means "serve the frontend from the same origin", which is the default
# and the right one: a private workspace has no reason for CORS at all. Set it
# only for the Vite dev server on :5173.
# The origin providers redirect back to, and the port the app serves on.
# 8900 rather than 8000: 8000 is conventionally an OpenAI-compatible server, and
# a collision there shows up as a 502 from a proxy rather than a clear error.
# Must match the redirect URI registered in each provider's app console.
OMNI_PUBLIC_URL=http://127.0.0.1:8900
OMNI_PORT=8900

OMNI_CORS=
OMNI_SERVE_FRONTEND=1
# OMNI_FRONTEND_DIST=./frontend/dist

# --- docker profile only ---------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=omnilinker
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=omnilinker

# --- provider credentials --------------------------------------------------
# Each connector needs only its own; the demo connector needs none. Every scope
# a connector requests is declared with a justification at registration, and
# registration is refused without one.
# Each OAuth provider needs its own client id, by convention - no per-provider
# config field, so shipping a connector requires no change to this file.
# The Connectors page shows exactly which variable is missing for each one.
#   OMNI_OAUTH_SLACK_CLIENT_ID / _CLIENT_SECRET
#   OMNI_OAUTH_GMAIL_CLIENT_ID / _CLIENT_SECRET
#   OMNI_OAUTH_GDRIVE_CLIENT_ID / _CLIENT_SECRET   (Google: same app works)
#   OMNI_OAUTH_ONEDRIVE_CLIENT_ID / _CLIENT_SECRET
#   OMNI_OAUTH_DISCORD_CLIENT_ID / _CLIENT_SECRET
#   OMNI_OAUTH_YOUTUBE_CLIENT_ID / _CLIENT_SECRET
#   OMNI_OAUTH_DROPBOX_CLIENT_ID / _CLIENT_SECRET
#
# Notion and Evernote publish *public* clients whose identifier is not a secret
# and is built into the connector, so only the secret is optional for them.
#
# WhatsApp is a file upload and needs no credentials at all. The demo connector
# is synthetic and needs none either.
